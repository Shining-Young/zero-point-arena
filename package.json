{
  "name": "zero-point-arena",
  "version": "0.2.3",
  "main": "electron/main.cjs",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --experimental-transform-types --test tests/*.test.mjs",
    "test:server": "node --experimental-transform-types --test tests/protocol.test.mjs tests/rooms.test.mjs tests/simulation.test.mjs tests/gateway.test.mjs",
    "typecheck": "tsc --noEmit",
    "server:dev": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "client:dev": "vite --config vite.client.config.ts",
    "client:build": "vite build --config vite.client.config.ts",
    "desktop:open": "wait-on http://localhost:5173 && set ELECTRON_DEV_URL=http://localhost:5173&& electron .",
    "desktop:dev": "run-p client:dev desktop:open",
    "desktop:pack": "npm run client:build && electron-builder --win zip --x64",
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "npm-run-all": "^4.1.5",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wait-on": "^9.1.0",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
